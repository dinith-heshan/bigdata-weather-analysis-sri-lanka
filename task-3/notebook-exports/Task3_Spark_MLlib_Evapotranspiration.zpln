    {
      "text": "%spark.pyspark\n\nrfr = RandomForestRegressor(\n    featuresCol=\"features\",\n    labelCol=\"label\",\n    seed=42\n)\n\nrfr_param_grid = (\n    ParamGridBuilder()\n    .addGrid(rfr.numTrees, [50, 75, 100])\n    .addGrid(rfr.maxDepth, [5, 10, 15]) \n    .build()\n)\n\nrfr_cv = CrossValidator(\n    estimator=rfr,\n    estimatorParamMaps=rfr_param_grid,\n    evaluator=evaluator,\n    numFolds=5\n)\n\nrfr_model = rfr_cv.fit(train_data)\n",
