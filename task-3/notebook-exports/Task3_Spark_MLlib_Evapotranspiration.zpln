    {
      "text": "%spark.pyspark\n\ngbtr = GBTRegressor(\n    featuresCol=\"features\",\n    labelCol=\"label\",\n    seed=42\n)\n\ngbtr_param_grid = (\n    ParamGridBuilder()\n    .addGrid(gbtr.maxIter, [150, 175, 200])\n    .addGrid(gbtr.maxDepth, [1, 3, 5])\n    .build()\n)\n\ngbtr_cv = CrossValidator(\n    estimator=gbtr,\n    estimatorParamMaps=gbtr_param_grid,\n    evaluator=evaluator,\n    numFolds=5\n)\n\ngbtr_model = gbtr_cv.fit(train_data)\n",
